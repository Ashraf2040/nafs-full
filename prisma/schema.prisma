generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ===================== ENUMS ===================== */

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ProficiencyStatus {
  BELOW
  APPROACHING
  MEETS
  EXCEEDS
}

enum TrophyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PathStatus {
  PENDING
  PRACTICING
  MASTERED
}

/* ===================== USER ===================== */

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  role      Role     @default(STUDENT)

  gradeId   String?
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id])

  quizzes     Quiz[]              @relation("CreatedBy")
  submissions Result[]
  assignments TeacherAssignment[]
  createdStudyGuides StudyGuide[]

  skillMastery    SkillMastery[]
  learningPath    LearningPathItem[]
  trophies        Trophy[]
  challengeParticipation ChallengeParticipation[]
  createdChallenges      Challenge[]          @relation("CreatedChallenges")

  createdAt DateTime @default(now())
  @@index([role])
  @@index([gradeId])
}

/* ===================== SUBJECT (STATIC) ===================== */

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  colorCode   String?

  quizzes     Quiz[]
  assignments TeacherAssignment[]
  outcomes    LearningOutcome[] @relation("SubjectOutcomes")
  studyGuides StudyGuide[]

  createdAt   DateTime @default(now())
}

/* ===================== GRADE (STATIC) ===================== */

model Grade {
  id    String @id @default(cuid())
  level Int    @unique
  name  String?

  quizzes     Quiz[]
  assignments TeacherAssignment[]
  users       User[]
  classes     Class[]
  studyGuides StudyGuide[]

  createdAt DateTime @default(now())
}

/* ===================== CLASS ===================== */

model Class {
  id        String   @id @default(cuid())
  name      String
  
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  
  users     User[]
  
  createdAt DateTime @default(now())
  
  @@unique([name, gradeId])
  @@index([gradeId])
}

/* ===================== TEACHER ASSIGNMENT ===================== */

model TeacherAssignment {
  id        String @id @default(cuid())

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  gradeId   String
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, gradeId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([gradeId])
}

/* ===================== QUIZ ===================== */

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPublished Boolean  @default(false)
  dueDate     DateTime?
  isDiagnostic Boolean @default(false)

  gradeId     String
  grade       Grade     @relation(fields: [gradeId], references: [id])

  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])

  creatorId   String
  creator     User      @relation("CreatedBy", fields: [creatorId], references: [id])
  outcomeId   String?
  outcome     LearningOutcome? @relation(fields: [outcomeId], references: [id])

  testingWindowId String?
  testingWindow   TestingWindow? @relation(fields: [testingWindowId], references: [id])

  questions   Question[]
  results     Result[]

  createdAt   DateTime @default(now())
  @@index([isPublished])
  @@index([gradeId])
  @@index([subjectId])
  @@index([testingWindowId])
}

model StudyGuide {
  id          String   @id @default(cuid())
  title       String
  fileName    String
  fileUrl     String
  isPublished Boolean  @default(false)
  creatorId   String
  subjectId   String
  gradeId     String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade       Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([gradeId, subjectId, isPublished])
  @@index([creatorId])
}

/* ===================== QUESTION ===================== */

model Question {
  id            String   @id @default(cuid())

  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionText  String   @db.Text
  questionType  String
  options       Json?
  correctAnswer String
  explanation   String?  @db.Text
  imageUrl      String?
  bloomLevel    String?
  difficulty    String?

  learningOutcomeId String?
  learningOutcome   LearningOutcome? @relation(fields: [learningOutcomeId], references: [id])

  answers       StudentAnswer[]
  createdAt     DateTime @default(now())
  @@index([quizId])
}

/* ===================== RESULT ===================== */

model Result {
  id          String   @id @default(cuid())
  score       Float
  totalPoints Float
  timeSpentSeconds Int?
  totalItems      Int?
  attemptsCount   Int      @default(1)

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers     StudentAnswer[]
  completedAt DateTime @default(now())
  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
  @@index([completedAt])
}

/* ===================== STUDENT ANSWER ===================== */

model StudentAnswer {
  id            String   @id @default(cuid())

  resultId String
  result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  studentAnswer String
  isCorrect     Boolean

  createdAt DateTime @default(now())
  @@index([resultId])
  @@index([questionId])
}

/* ===================== LEARNING OUTCOME ===================== */

model LearningOutcome {
  id            String  @id @default(cuid())
  grade         Int
  subject       String
  subDomain     String?
  outcomeText   String  @db.Text
  indicatorText String  @db.Text

  subjectRefId String?
  subjectRef   Subject? @relation("SubjectOutcomes", fields: [subjectRefId], references: [id])

  questions Question[]
  quizzes   Quiz[]
  skillMastery SkillMastery[]
  learningPathItems LearningPathItem[]
  createdAt DateTime @default(now())
  @@index([grade])
  @@index([subject])
}

/* ===================== TESTING WINDOW ===================== */

model TestingWindow {
  id        String   @id @default(cuid())
  name      String
  subject   String
  grade     Int
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  quizzes   Quiz[]
  skillMastery SkillMastery[]

  createdAt DateTime @default(now())
  @@unique([name, subject, grade])
  @@index([subject, grade])
}

/* ===================== SKILL MASTERY ===================== */

model SkillMastery {
  id            String   @id @default(cuid())
  studentId     String
  outcomeId     String
  testingWindowId String?

  masteryLevel  Float    @default(0)
  attemptsCount Int      @default(0)
  correctCount  Int      @default(0)
  status        ProficiencyStatus @default(BELOW)
  lastAssessedAt DateTime @default(now())

  student       User            @relation(fields: [studentId], references: [id])
  outcome       LearningOutcome @relation(fields: [outcomeId], references: [id])
  testingWindow TestingWindow?  @relation(fields: [testingWindowId], references: [id])

  @@unique([studentId, outcomeId, testingWindowId])
  @@index([studentId])
  @@index([outcomeId])
}

/* ===================== LEARNING PATH ITEM ===================== */

model LearningPathItem {
  id            String     @id @default(cuid())
  studentId     String
  outcomeId     String
  sequenceOrder Int
  status        PathStatus @default(PENDING)

  student User            @relation(fields: [studentId], references: [id])
  outcome LearningOutcome @relation(fields: [outcomeId], references: [id])

  @@unique([studentId, outcomeId])
  @@index([studentId])
  @@index([outcomeId])
}

/* ===================== TROPHY ===================== */

model Trophy {
  id        String     @id @default(cuid())
  studentId String
  subject   String
  domain    String?
  tier      TrophyTier
  name      String
  outcomesMastered Int

  earnedAt  DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, subject, domain, tier])
}

/* ===================== CHALLENGE ===================== */

model Challenge {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("CreatedChallenges", fields: [teacherId], references: [id])
  title       String
  description String?
  criteria    Json
  rewardBadge String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)

  participations ChallengeParticipation[]

  createdAt DateTime @default(now())

  @@index([teacherId])
}

model ChallengeParticipation {
  id          String   @id @default(cuid())
  challengeId String
  studentId   String
  progress    Float    @default(0)
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id])

  @@unique([challengeId, studentId])
}
